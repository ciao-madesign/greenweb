{
  "manifest_version": 3,
  "name": "Greenweb",
  "version": "0.1.0",
  "description": "Estimates the environmental footprint of your browsing. Local only, no account, no telemetry.",
  "permissions": [
    "webRequest",
    "idle",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Greenweb",
    "default_icon": {
      "16": "icons/leaf-green-16.png",
      "32": "icons/leaf-green-32.png",
      "48": "icons/leaf-green-48.png",
      "128": "icons/leaf-green-128.png"
    }
  },
  "icons": {
    "16": "icons/leaf-green-16.png",
    "32": "icons/leaf-green-32.png",
    "48": "icons/leaf-green-48.png",
    "128": "icons/leaf-green-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "digital-footprint-counter@greenweb.local",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
